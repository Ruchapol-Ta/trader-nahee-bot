# Signal Bot Secrets Template (Fix #15)
# Copy this file to `.env` and fill in your values. `.env` is gitignored.
#
# How to obtain:
#   TELEGRAM_BOT_TOKEN → talk to @BotFather on Telegram, /newbot, copy the token
#   TELEGRAM_CHAT_ID   → send any message to your bot, then visit
#                          https://api.telegram.org/bot<TOKEN>/getUpdates
#                          and copy the "chat":{"id":...} value

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
