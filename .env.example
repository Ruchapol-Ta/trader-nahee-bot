# Signal Bot Secrets Template (Fix #15)
# Copy this file to `.env` and fill in your values. `.env` is gitignored.
#
# How to obtain:
#   TELEGRAM_BOT_TOKEN → create a bot with BotFather
#   TELEGRAM_CHAT_ID   → legacy/default chat id for normal runs
#                          https://api.telegram.org/bot<TOKEN>/getUpdates
#                          and copy the "chat":{"id":...} value
#
# Optional delivery safety:
#   TELEGRAM_TARGET_MODE=test sends only to TELEGRAM_TEST_CHAT_ID.
#   TELEGRAM_TARGET_MODE=prod sends to TELEGRAM_PROD_CHAT_ID, falling back to
#   TELEGRAM_CHAT_ID for backward-compatible production runs.

TELEGRAM_BOT_TOKEN=<your_telegram_bot_token>
TELEGRAM_CHAT_ID=<your_default_chat_id>
TELEGRAM_TEST_CHAT_ID=<your_test_chat_id>
TELEGRAM_PROD_CHAT_ID=<your_prod_chat_id>
TELEGRAM_TARGET_MODE=test
