# Signal Bot Secrets Template
# Copy this file to `.env` and fill in your values. `.env` is gitignored.
#
# Optional delivery safety:
#   TELEGRAM_TARGET_MODE=test sends only to TELEGRAM_TEST_CHAT_ID.
#   TELEGRAM_TARGET_MODE=prod sends to TELEGRAM_PROD_CHAT_ID. TELEGRAM_CHAT_ID
#   is legacy-only and should not be used for Slice 9 test delivery.

TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_TARGET_MODE=test
TELEGRAM_TEST_CHAT_ID=your_test_chat_id_here
TELEGRAM_PROD_CHAT_ID=your_prod_chat_id_here
TELEGRAM_CHAT_ID=legacy_chat_id_optional
